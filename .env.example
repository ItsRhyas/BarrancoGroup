# Database identity (single source of truth).
# Compose reconstructs the container DATABASE_URL from these values.
POSTGRES_USER=change_this_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=change_this_database

# Host connection string for hybrid dev (pnpm run dev).
# The backend runs on your machine and reaches the database
# published on localhost:5432 by Docker.
DATABASE_URL=postgresql://change_this_user:change_this_password@localhost:5432/change_this_database?schema=public

# Application
PORT=3000

# Environment
NODE_ENV=development

# Security
JWT_SECRET=change_this_secret

