# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
POSTGRES_USER=change_this_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=change_this_database

# ── Application ───────────────────────────────────────
PORT=3000

# ── Environment ───────────────────────────────────────
NODE_ENV=development
