generator client {
  provider            = "prisma-client"
  output              = "../apps/backend/src/generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USUARIO
  AUDITOR
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USUARIO)
  createdAt    DateTime @default(now())

  @@map("users")
}

model GameSession {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  createdAt    DateTime  @default(now())
  attempts     Attempt[]

  @@map("game_sessions")
}

model Attempt {
  id            String      @id @default(uuid())
  sessionId     String
  levelId       String
  success       Boolean
  endingId      String?
  attemptNumber Int
  completedAt   DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, levelId, attemptNumber])
  @@index([sessionId])
  @@index([levelId])
  @@map("attempts")
}
